{
  "name": "dsh-harness-pet",
  "version": "0.10.2",
  "description": "Harness 窗口内大肥鱼：Agent 计时、完成与确认提示音、喝水休息提醒",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/pet-animated-v2.png",
    "assets/PROMPT-v2.md",
    "assets/pet-reminders-v4.png",
    "assets/PROMPT-v4.md",
    "assets/pet-complete-v5.png",
    "assets/PROMPT-v5.md",
    "assets/pet-endings-v6.png",
    "assets/PROMPT-v6.md",
    "assets/pet-tools-v10.png",
    "assets/PROMPT-v10.md",
    "README.md",
    "docs/compatibility.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
